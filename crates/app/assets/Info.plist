<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- macOS 15+ asks before an app talks to the local network (direct connections, mDNS). -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Dari connects to other devices on your network for remote desktop sessions and finds nearby devices.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_dari._udp</string>
	</array>
	<!-- macOS 14.6+ asks before an app records the system's sound output (process tap). -->
	<key>NSAudioCaptureUsageDescription</key>
	<string>Dari lets the person connected to this device hear its sound during remote desktop sessions.</string>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
</dict>
</plist>
